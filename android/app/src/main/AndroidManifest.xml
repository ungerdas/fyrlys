<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- listene og strømmene hentes over nettet (også http, som mange IPTV-leverandører bruker) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Chromecast: lete etter dem på wifi (multicast), og holde wifi og appen i gang mens telefonen sender strømmen
         videre til TV-en (en tjeneste med et varsel, også når skjermen er av) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- nye versjoner fra GitHub: Android spør deg før noe installeres -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="Fyrlys"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- mens det castes: holder appen og wifi i gang; stopper når appen lukkes (da kan ikke telefonen sende videre) -->
        <service
            android:name=".CastService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="mediaPlayback"/>
        <!-- APK-en som er lastet ned, til Android sin installering (bare den, og bare når Fyrlys gir lov) -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.oppdatering"
            android:exported="false"
            android:grantUriPermissions="true"/>
        <!-- Flutter lager GeneratedPluginRegistrant ut fra denne -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- nettleseren («Meld fra om en feil») -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
